{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@delulu/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "../validators"
    }
  ]
}
