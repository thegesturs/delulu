{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@delulu/auth": ["../auth/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
