{
  "name": "@delulu/database",
  "version": "0.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "analyze": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "build": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",

    "migrate:dev": "prisma migrate dev --name init",
    "migrate:dev:create-only": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:resolve:applied": "prisma migrate resolve --applied <migration-name>",
    "migrate:resolve:rolled-back": "prisma migrate resolve --rolled-back <migration-name>",
    "migrate:status": "prisma migrate status",
    "migrate:diff": "prisma migrate diff",

    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:execute": "prisma db execute --file <file.sql>",

    "client:generate": "prisma generate",
    "client:validate": "prisma validate",
    "client:format": "prisma format",

    "utils:init": "prisma init",
    "utils:studio": "prisma studio",
    "utils:version": "prisma version"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-neon": "6.4.1",
    "@prisma/client": "6.4.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "server-only": "^0.0.1",
    "undici": "^7.8.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@delulu/typescript-config": "workspace:*",
    "@prisma/generator-helper": "^6.8.2",
    "@types/node": "22.14.1",
    "@types/react": "^19.1.5",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.9",
    "nanoid": "^5.1.5",
    "prisma": "6.4.1",
    "react": "^19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
