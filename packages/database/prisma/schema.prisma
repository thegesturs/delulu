// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}



datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum CurrentPlan {
  FREE
  PRO
  PRO2
  PRO3
}

enum PostStatus {
  SAVED
  PUBLISHED
  SCHEDULED
  DELETED
  FAILED
}

enum PostReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrivacyStatus {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum PostType {
  NORMAL
  SHORT
  LONG_VIDEO
}

enum SocialType {
  TWITTER
  LINKEDIN
  LENS
  GITHUB
  YOUTUBE
  INSTAGRAM
  FACEBOOK
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

// enum InviteStatus {
//   PENDING
//   ACCEPTED
//   REJECTED
//   CANCELLED
// }

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model User {
  clerkUserId    String     @id @map("clerk_user_id") @db.VarChar(256)
  email          String     @map("email") @db.VarChar(256)
  name           String     @map("name") @db.VarChar(256)
  image          String     @map("image") @db.VarChar(256)
  currentPlan    CurrentPlan @default(FREE) @map("current_plan")
  personalization Json?      @map("personalization")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  userUsage      UserUsage?
  ownedOrganizations  Organization[]    // Owned organizations
  memberships OrganizationMember[] // Organizations where user is a member
  posts          Post[]
  socialProviders SocialProvider[]
  subscriptions  Subscription[]
  orders         Order[]
  // organizationInvites OrganizationInvites[] @relation("InvitedBy")

  @@map("users")
}

model UserUsage {
  clerkUserId         String   @unique @map("clerk_user_id") @db.VarChar(256)
  socialAccounts Int      @default(4) @map("social_accounts")
  generatedPosts Int      @default(50) @map("generated_posts")
  drafts         Int      @default(15) @map("drafts")
  organization   Int      @default(0) @map("organization")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user           User     @relation(fields: [clerkUserId], references: [clerkUserId], onDelete: Cascade)

  @@map("user_usage")
}

model Organization {
  clerkOrgId    String   @id @map("clerk_org_id") @db.VarChar(256)
  ownerId       String   @map("owner_id") @db.VarChar(256)
  name          String   @db.VarChar(256)
  logo          String?  @db.VarChar(256)
  category      String   @default("personal") @db.VarChar(256)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  owner         User     @relation(fields: [ownerId], references: [clerkUserId], onDelete: Cascade)
  // invites       OrganizationInvites[]
  members       OrganizationMember[]
  posts         Post[]
  socialProviders SocialProvider[]

  @@index([ownerId])
  @@map("organizations")
}

