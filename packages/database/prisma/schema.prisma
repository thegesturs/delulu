model OrganizationMember {
  organizationId String     @map("organization_id") @db.VarChar(256)
  userId         String     @map("user_id") @db.VarChar(256)
  role           Role       @default(MEMBER)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [clerkOrgId], onDelete: Cascade)
  member         User        @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)

  @@id([organizationId, userId])
  @@unique([organizationId, userId])
  @@index([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Post {
  id                String           @id @db.VarChar(191)
  userId           String           @map("user_id") @db.VarChar(256)
  postType         PostType         @default(NORMAL) @map("post_type")
  status           PostStatus
  scheduledAt      DateTime?        @map("scheduled_at") @db.Timestamptz
  reviewStatus     PostReviewStatus @default(PENDING) @map("review_status")
  organizationId   String?          @map("organization_id") @db.VarChar(256)
  isDeleted        Boolean          @default(false) @map("is_deleted")
  postFailureReason String?         @map("post_failure_reason") @db.Text
  privacyStatus    PrivacyStatus    @default(UNLISTED) @map("privacy_status")
  content          Json             @default("[]")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz
  lastFailedAt     DateTime?        @map("last_failed_at") @db.Timestamptz
  retryCount       Int              @default(0) @map("retry_count")

  // Relations
  organization     Organization?    @relation(fields: [organizationId], references: [clerkOrgId], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  alternateContents AlternatePostContent[]
  socialProviders  SocialProvider[] @relation("PostToSocialProvider")
  platformPosts    PlatformPost[]

  @@index([userId])
  @@index([organizationId])
  @@index([status, scheduledAt])
  @@map("posts")
}

model AlternatePostContent {
  postId          String @map("post_id") @db.VarChar(191)
  socialProviderId String @map("social_provider_id") @db.VarChar(191)
  content         Json   @default("[]")

  // Relations
  post            Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialProvider  SocialProvider @relation(fields: [socialProviderId], references: [id], onDelete: Cascade)

  @@id([postId, socialProviderId])
  @@map("alternate_post_content")
  @@index([socialProviderId])
}

model PlatformPost {
  id              String @id @db.VarChar(191)
  postId          String @map("post_id") @db.VarChar(191)
  platformId      String @map("platform_id") @db.VarChar(191)
  platformPostId  String @map("platform_post_id") @db.VarChar(191)
  platformPostUrl String @map("platform_post_url") @db.Text

  // Relations
  post            Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialProvider  SocialProvider @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@map("platform_posts")
  @@index([postId])
  @@index([platformId])
}



model SocialProvider {
  id                    String    @id @db.VarChar(191)
  organizationId        String?   @map("organization_id") @db.VarChar(256)
  userId               String    @map("user_id") @db.VarChar(191)
  clientId             String?   @map("client_id") @db.VarChar(191)
  clientSecret         String?   @map("client_secret") @db.VarChar(191)
  accessToken          String    @map("access_token") @db.Text
  refreshToken         String?   @map("refresh_token") @db.Text
  expiresIn            DateTime  @map("expires_in") @db.Timestamptz
  refreshTokenExpiresIn DateTime? @map("refresh_token_expires_in") @db.Timestamptz
  profileId            String    @map("profile_id") @db.VarChar(191)
  username             String?   @db.VarChar(191)
  fullName             String    @default("") @map("full_name") @db.VarChar(191)
  profileImage         String    @default("") @map("profile_image") @db.Text
  socialType           SocialType @map("social_type")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isActive             Boolean   @default(true) @map("is_active")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz

  // Relations
  organization         Organization? @relation(fields: [organizationId], references: [clerkOrgId], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  posts               Post[]       @relation("PostToSocialProvider")
  alternateContents   AlternatePostContent[]
  platformPosts       PlatformPost[]

  @@unique([profileId, organizationId])
  @@unique([userId, profileId])
  @@index([userId])
  @@index([organizationId])
  @@map("social_providers")
}

model Subscription {
  id                 String            @id @map("id")
  userId             String            @map("user_id")
  status             SubscriptionStatus @map("status")
  priceId            String            @map("price_id")
  productId          String            @map("product_id")
  amount             Int               @map("amount")
  currency           String            @map("currency")
  reoccurringInterval String           @map("reoccurring_interval")
  customerId         String            @map("customer_id")
  currentPeriodStart DateTime          @map("current_period_start")
  currentPeriodEnd   DateTime          @map("current_period_end")
  cancelAtPeriodEnd  Boolean           @map("cancel_at_period_end")
  endsAt             DateTime?         @map("ends_at")
  endedAt            DateTime?         @map("ended_at")
  startedAt          DateTime?         @map("started_at")
  canceledAt         DateTime?         @map("canceled_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("subscriptions")
}

model Order {
  id                String   @id @map("id")
  userId            String   @map("user_id")
  status            String   @map("status")
  paid              Boolean  @map("paid")
  subtotalAmount    Int      @map("subtotal_amount")
  discountAmount    Int      @map("discount_amount")
  netAmount         Int      @map("net_amount")
  amount            Int      @map("amount")
  taxAmount         Int      @map("tax_amount")
  totalAmount       Int      @map("total_amount")
  refundedAmount    Int      @map("refunded_amount")
  refundedTaxAmount Int      @map("refunded_tax_amount")
  currency          String   @map("currency") @db.VarChar(5)
  billingReason     String   @map("billing_reason")
  customerId        String   @map("customer_id")
  productId         String   @map("product_id")
  productPriceId    String   @map("product_price_id")
  discountId        String?  @map("discount_id")
  subscriptionId    String?  @map("subscription_id")
  checkoutId        String?  @map("checkout_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@map("orders")
}

