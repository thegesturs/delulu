// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator zod {
  provider                 = "zod-prisma-types"
  createInputTypes         = true
  createModelTypes         = true
  createOptionalDefaultValuesTypes = false
  output                   = "./types/zod"
  addInputTypeValidation   = true
}
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}


datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum CurrentPlan {
  FREE
  PRO
  PRO2
  PRO3
}

enum PostStatus {
  SAVED
  PUBLISHED
  SCHEDULED
  DELETED
  FAILED
}

enum PostReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrivacyStatus {
  PUBLIC
  PRIVATE
  UNLISTED
}


enum SocialType {
  TWITTER
  LINKEDIN
  LENS
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  THREADS
  PINTEREST
  FARCASTER
}


model User {
  id              String    @id @default(cuid()) @db.VarChar(256)
  email           String     @map("email") @db.VarChar(256)
  emailVerified   Boolean    @default(false) @map("email_verified")
  name            String     @map("name") @db.VarChar(256)
  image           String?    @map("image") @db.VarChar(256)
  currentPlan     CurrentPlan @default(FREE) @map("current_plan")
  personalization Json?      @map("personalization")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  userUsage       UserUsage?
  sessions        Session[]
  accounts        Account[]
  socialProviders SocialProvider[]
  posts           Post[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id") @db.VarChar(256)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.VarChar(256)
  accountId         String  @map("account_id") @db.VarChar(256)
  providerId        String  @map("provider_id") @db.VarChar(256)
  accessToken       String? @map("access_token") @db.Text
  refreshToken      String? @map("refresh_token") @db.Text
  idToken           String? @map("id_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope             String? @db.Text
  password          String? @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @db.VarChar(256)
  value      String   @db.VarChar(256)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([identifier, value])
  @@map("verifications")
}

model UserUsage {
  userId         String   @unique @map("user_id") @db.VarChar(256)
  socialAccounts Int      @default(4) @map("social_accounts")
  generatedPosts Int      @default(50) @map("generated_posts")
  drafts         Int      @default(15) @map("drafts")
  organization   Int      @default(0) @map("organization")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_usage")
}





model Post {
  id                String           @id @db.VarChar(191)
  userId           String?           @map("user_id") @db.VarChar(256)
  status           PostStatus
  scheduledAt      DateTime?        @map("scheduled_at") @db.Timestamptz
  reviewStatus     PostReviewStatus @default(PENDING) @map("review_status")
  organizationId   String?          @map("organization_id") @db.VarChar(256)
  isDeleted        Boolean          @default(false) @map("is_deleted")
  postFailureReason String?         @map("post_failure_reason") @db.Text
  privacyStatus    PrivacyStatus    @default(UNLISTED) @map("privacy_status")
  content          Json             @default("[]")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz
  lastFailedAt     DateTime?        @map("last_failed_at") @db.Timestamptz
  retryCount       Int              @default(0) @map("retry_count")

  // Relations
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alternateContents AlternatePostContent[]
  socialProviders  SocialProvider[] @relation("PostToSocialProvider")
  platformPosts    PlatformPost[]

  @@index([userId])
  @@index([organizationId])
  @@index([status, scheduledAt])
  @@map("posts")
}

model AlternatePostContent {
  postId          String @map("post_id") @db.VarChar(191)
  socialProviderId String @map("social_provider_id") @db.VarChar(191)
  content         Json   @default("[]")

  // Relations
  post            Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialProvider  SocialProvider @relation(fields: [socialProviderId], references: [id], onDelete: Cascade)

  @@id([postId, socialProviderId])
  @@map("alternate_post_content")
  @@index([socialProviderId])
}

model PlatformPost {
  id              String @id @db.VarChar(191)
  postId          String @map("post_id") @db.VarChar(191)
  platformId      String @map("platform_id") @db.VarChar(191)
  platformPostId  String @map("platform_post_id") @db.VarChar(191)
  platformPostUrl String @map("platform_post_url") @db.Text

  // Relations
  post            Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialProvider  SocialProvider @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@map("platform_posts")
  @@index([postId])
  @@index([platformId])
}



model SocialProvider {
  id                    String    @id @db.VarChar(191)
  organizationId        String?   @map("organization_id") @db.VarChar(256)
  userId               String?    @map("user_id") @db.VarChar(191)
  clientId             String?   @map("client_id") @db.VarChar(191)
  clientSecret         String?   @map("client_secret") @db.VarChar(191)
  accessToken          String    @map("access_token") @db.Text
  refreshToken         String?   @map("refresh_token") @db.Text
  expiresIn            DateTime  @map("expires_in") @db.Timestamptz
  refreshTokenExpiresIn DateTime? @map("refresh_token_expires_in") @db.Timestamptz
  profileId            String    @map("profile_id") @db.VarChar(191)
  username             String?   @db.VarChar(191)
  fullName             String    @default("") @map("full_name") @db.VarChar(191)
  profileImage         String    @default("") @map("profile_image") @db.Text
  socialType           SocialType @map("social_type")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isActive             Boolean   @default(true) @map("is_active")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz

  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts               Post[]       @relation("PostToSocialProvider")
  alternateContents   AlternatePostContent[]
  platformPosts       PlatformPost[]

  @@unique([profileId, organizationId])
  @@unique([userId, profileId])
  @@index([userId])
  @@index([organizationId])
  @@map("social_providers")
}

