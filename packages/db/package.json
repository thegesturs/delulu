{
  "name": "@delulu/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pg:up": "docker compose up -d --wait",
    "pg:migrate": "tsx src/migrate.ts up",
    "pg:migrate:status": "tsx src/migrate.ts status",
    "migration-lint": "tsx src/migration-lint.ts"
  },
  "dependencies": {
    "@delulu/connections": "workspace:*",
    "@delulu/core": "workspace:*",
    "@effect/platform-node": "4.0.0-beta.97",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@delulu/typescript-config": "workspace:*",
    "@types/node": "22.14.1",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vitest": "^3.1.1"
  }
}
