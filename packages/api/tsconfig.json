{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./src/*"],
      "@delulu/*": ["../../packages/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"],
  "references": [{ "path": "../validators" }]
}
