{
  "name": "@delulu/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=neutral --format=esm --external:effect --external:effect/* --external:@delulu/core --external:@tanstack/react-query --outfile=dist/index.js",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@delulu/contracts": "workspace:*",
    "@delulu/core": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@delulu/typescript-config": "workspace:*",
    "esbuild": "^0.25.5",
    "typescript": "catalog:",
    "vitest": "^3.1.1"
  }
}
