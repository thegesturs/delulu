{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"],
      "@delulu/*": ["../../packages/*"]
    },
    "strictNullChecks": true
  },
  "include": ["./*.ts", "./*.tsx", "templates/**/*", "cf/**/*"],
  "exclude": ["node_modules"]
}
