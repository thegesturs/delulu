{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": [
    "./*.ts",
    "./*.tsx",
    "campaigns/**/*",
    "components/**/*",
    "renderers/**/*",
    "templates/**/*"
  ],
  "exclude": ["node_modules"]
}
