    "@delulu/validators": "workspace:*",
    "@delulu/worker": "workspace:*",
    "convex": "^1.28.2",
    "dotenv": "^16.4.7",
    "groq-sdk": "^0.12.0",
    "sst": "^3.17.10",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "tsx": "^4.19.2"
