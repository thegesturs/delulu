{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": false,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"],
      "@delulu/*": ["../../packages/*"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".sst/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
