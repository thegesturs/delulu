{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite",
    "ultracite/biome/core",
    "ultracite/biome/next"
  ],
  "javascript": {
    "globals": [
      "Liveblocks"
    ]
  },
  "files": {
    "includes": [
      "**",
      "!**/packages/design-system/components/ui/**",
      "!**/packages/design-system/lib/**",
      "!**/packages/design-system/hooks/**",
      "!**/packages/collaboration/config.ts",
      "!**/apps/docs/**/*.json",
      "!**/apps/email/.react-email/**",
      "!**/apps/app/wrangler.jsonc",
      "!**/packages/database/prisma/types/zod/**",
      "!**/packages/infrastructure/.sst/**",
      "!**/*.d.ts",
      "!**/packages/database/convex/_generated/**"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "noInferrableTypes": "off",
        "useFilenamingConvention": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noUselessElse": "error"
      },
      "a11y": {
        "noAriaUnsupportedElements": "warn",
        "useAltText": "warn",
        "useAriaPropsForRole": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn",
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "noChildrenProp": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error",
        "noUnusedImports": "warn"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noForEach": "off"
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noDangerouslySetInnerHtml": "warn"
      },
      "suspicious": {
        "noCommentText": "error",
        "noDuplicateJsxProps": "error",
        "noConsole": "off"
      }
    }
  }
}