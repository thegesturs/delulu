{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "javascript": {
    "globals": ["Liveblocks", "browser", "defineBackground"]
  },
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "files": {
    "includes": [
      "**/*.jsx",
      "**/*.tsx",
      "!**/packages/design-system/components/ui",
      "!**/packages/design-system/lib",
      "!**/packages/design-system/hooks",
      "!**/packages/collaboration/config.ts",
      "!**/apps/docs/**/*.json",
      "!**/apps/email/.react-email",
      "!**/apps/app/wrangler.jsonc",
      "!**/packages/infrastructure/.sst",
      "!**/*.d.ts",
      "!**/specs"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "noInferrableTypes": "off",
        "useFilenamingConvention": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noUselessElse": "error",
        "noNestedTernary": "off",
        "useCollapsedIf": "off",
        "noExportedImports": "warn"
      },
      "a11y": {
        "noAriaUnsupportedElements": "off",
        "useAltText": "off",
        "useAriaPropsForRole": "off",
        "useValidAriaProps": "off",
        "useValidAriaValues": "off",
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "noChildrenProp": "error",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "useJsxKeyInIterable": "error",
        "noUnusedImports": "off",
        "useImageSize": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "noNestedComponentDefinitions": "off",
        "noInvalidUseBeforeDeclaration": "off",
        "noUndeclaredVariables": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noCommentText": "error",
        "noDuplicateJsxProps": "error",
        "noConsole": "off",
        "noArrayIndexKey": "off",
        "useAwait": "off",
        "useIterableCallbackReturn": "off",
        "noEvolvingTypes": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noImgElement": "off"
      }
    }
  }
}
