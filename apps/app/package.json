{
  "name": "app",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --turbopack",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true npm run build",
    "test": "NODE_ENV=test vitest run",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@delulu/analytics": "workspace:*",
    "@delulu/auth": "workspace:*",
    "@delulu/collaboration": "workspace:*",
    "@delulu/database": "workspace:*",
    "@delulu/design-system": "workspace:*",
    "@delulu/feature-flags": "workspace:*",
    "@delulu/next-config": "workspace:*",
    "@delulu/notifications": "workspace:*",
    "@delulu/observability": "workspace:*",
    "@delulu/security": "workspace:*",
    "@delulu/seo": "workspace:*",
    "@delulu/webhooks": "workspace:*",
    "@opennextjs/cloudflare": "^1.0.4",
    "@sentry/nextjs": "^9.12.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "fuse.js": "^7.1.0",
    "import-in-the-middle": "^1.13.1",
    "lucide-react": "^0.511.0",
    "next": "15.3.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "require-in-the-middle": "^7.5.2",
    "svix": "^1.64.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@delulu/testing": "workspace:*",
    "@delulu/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.14.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
