# apps/app environment.
# Social connectors, media (R2), email, and billing now live in the API worker
# (apps/api) — this app only talks to it over NEXT_PUBLIC_API_URL.

# Server
CLERK_SECRET_KEY=""
# Optional: comma-separated emails granted admin-only feature flags / insights.
# Must match NEXT_PUBLIC_ADMIN_EMAILS below.
ADMIN_EMAILS=""
# Optional (security keys) — Arcjet protection.
ARCJET_KEY=""

# Client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Client-visible copy of the admin allowlist (same value as ADMIN_EMAILS).
NEXT_PUBLIC_ADMIN_EMAILS=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_POSTHOG_PROXY_HOST="https://metrics.delulu.social"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Affiliates (Affonso)
NEXT_PUBLIC_AFFONSO_PROGRAM_ID=""
NEXT_PUBLIC_AFFONSO_PORTAL_URL=""

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
# API worker. Defaults to https://api.delulu.social when unset; point at the
# local wrangler dev server for local development.
NEXT_PUBLIC_API_URL="http://localhost:8788"
