{
  "extends": "@delulu/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@delulu/*": ["../../packages/*"],
      "@api/*": ["../../packages/api/*"]
    },
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true
  },
  "exclude": [
    "../../packages/database/prisma/types/zod/**/*",
    "../../packages/database/prisma/types/zod/index.ts"
  ],
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
