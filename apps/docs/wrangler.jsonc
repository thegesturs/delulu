{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delulu-docs",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "docs.delulu.social",
      "custom_domain": true
    }
  ]
}
