{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "delulu-social-landing",
  "compatibility_date": "2024-12-30",
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "production": {
      "vars": {
        "NEXT_PUBLIC_APP_URL": "https://solulu.delulu.social",
        "NEXT_PUBLIC_WEB_URL": "https://www.delulu.social",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
        "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/",
        "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/",
        "NEXT_PUBLIC_POSTHOG_KEY": "phc_A5NWdEHAyUyzoUUSKnemshpamt3MCdbh9ztSxH0RvQV",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "NEXT_PUBLIC_POSTHOG_PROXY_HOST": "https://metrics.delulu.social"
      }
    }
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "delulu-social-landing"
    }
  ],
  // Blog articles: R2 stores full article bodies, KV stores list/meta index.
  // Replaces previous Convex-backed articles table — see packages/articles.
  // Create with: wrangler r2 bucket create delulu-articles
  //              wrangler kv:namespace create DELULU_ARTICLES_KV
  //              wrangler kv:namespace create DELULU_ARTICLES_KV --preview
  // Then paste the resulting ids below.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "delulu-articles",
      "preview_bucket_name": "delulu-articles-dev"
    },
    {
      "binding": "DELULU_ARTICLES_BUCKET",
      "bucket_name": "delulu-articles",
      "preview_bucket_name": "delulu-articles-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DELULU_ARTICLES_KV",
      "id": "6604544fdc7e4f9f9537d726552eb868",
      "preview_id": "3dbe94bc460442aea16f46f44dac3435"
    }
  ]
}
