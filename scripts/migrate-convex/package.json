    "fflate": "0.8.2",
    "nanoid": "5.1.6",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@delulu/db": "workspace:*",
    "@delulu/typescript-config": "workspace:*",
    "@types/node": "22.14.1",
    "tsx": "^4.20.3",
    "typescript": "catalog:",
    "vitest": "^3.1.1",
    "@types/yauzl": "2.10.3"
  }
}
